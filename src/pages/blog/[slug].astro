---
import Layout from '../../layouts/Layout.astro';
import { getArticleBySlug, renderBlocks, formatDate, mediaUrl } from '../../lib/strapi.ts';

const runtimeEnv = Astro.locals?.runtime?.env;
const { slug } = Astro.params;

if (!slug) {
  return new Response('Not found', { status: 404 });
}

let article = null;
try {
  article = await getArticleBySlug(slug, runtimeEnv);
} catch (err) {
  console.error(`Failed to load article ${slug}:`, err);
  return new Response('Internal error', { status: 500 });
}

if (!article) {
  return new Response('Not found', { status: 404 });
}

const SITE = 'https://chaparraldsllc.com';
const canonical = `${SITE}/blog/${article.slug}`;
const coverUrl = article.coverImage ? mediaUrl(article.coverImage.url, runtimeEnv) : undefined;
const ogImage = coverUrl ?? `${SITE}/assets/img/logo.svg`;
const description = article.excerpt ?? `Read "${article.title}" on the Chaparral Disposal blog.`;

// If bodyHtml is filled in, treat the post as a full-takeover: skip the article
// wrapper (title, meta, back-link, cover) and emit the raw HTML straight between
// header and footer. Editors get full pixel control and can include their own
// <style> tags. Header/footer remain so the site brand stays intact.
//
// NOT sanitized — Strapi publish access is restricted to trusted editors.
// If publishing is ever opened to external contributors, add a Workers-compatible
// sanitizer (DOMPurify uses jsdom internally and breaks in V8 isolates).
const useCustomLayout = !!article.bodyHtml?.trim();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": description,
  "image": coverUrl ? [coverUrl] : [`${SITE}/assets/img/logo.svg`],
  "datePublished": article.publishedAt,
  "dateModified": article.updatedAt,
  "author": { "@type": "Organization", "name": "Chaparral Disposal Service LLC", "url": SITE + '/' },
  "publisher": { "@id": SITE + '/#organization' },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  ...(article.category ? { "articleSection": article.category } : {})
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE + '/' },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": SITE + '/blog' },
    { "@type": "ListItem", "position": 3, "name": article.title, "item": canonical }
  ]
};
---

<Layout
  title={`${article.title} | Chaparral Disposal Service LLC`}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  {useCustomLayout ? (
    <Fragment set:html={article.bodyHtml} />
  ) : (
    <article class="article container">
      <a href="/blog" class="back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
        Back to blog
      </a>
      <div class="article__meta">
        {article.category && <span class="cat">{article.category}</span>}
        <span>{formatDate(article.publishedAt)}</span>
      </div>
      <h1>{article.title}</h1>
      {article.excerpt && <p class="article__lead">{article.excerpt}</p>}
      {article.coverImage && (
        <div class="article__cover">
          <img
            src={mediaUrl(article.coverImage.url, runtimeEnv)}
            alt={article.coverImage.alternativeText ?? ''}
            width={article.coverImage.width}
            height={article.coverImage.height}
          />
        </div>
      )}
      <div class="article__body" set:html={renderBlocks(article.content)} />

      <div class="article__cta">
        <h2>Need reliable waste service?</h2>
        <p>Get a free, no-pressure quote from your local, family-owned team.</p>
        <a class="btn btn--accent btn--lg" href="/contact">Get a Free Quote</a>
      </div>
    </article>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
