---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title={"Contact Us | Chaparral Disposal Service LLC — Get a Free Quote"}
  description={"Contact Chaparral Disposal Service LLC for reliable trash collection and dumpster rentals. Call (575) 824-0887 or request a free quote online."}
  canonical="https://chaparraldsllc.com/contact"
  cacheStrategy="static"
>
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a> / Contact</div>
    <span class="eyebrow">Get in touch</span>
    <h1>Let's set up your service</h1>
    <p>Questions, quotes, or ready to start? Reach out — a friendly local team member is happy to help.</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">

    <!-- Info column -->
    <div class="reveal">
      <div class="info-card">
        <div class="info-row">
          <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
          <div><b>Call Us</b><a href="tel:+15758240887">(575) 824-0887</a></div>
        </div>
        <div class="info-row">
          <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="m22 6-10 7L2 6"/></svg></span>
          <div><b>Email Us</b><a href="mailto:chaparraldisposal@yahoo.com">chaparraldisposal@yahoo.com</a></div>
        </div>
        <div class="info-row">
          <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <div><b>Visit / Mail</b><span>549 North Rd, Chaparral, NM 88081</span></div>
        </div>
        <div class="info-row">
          <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
          <div><b>Office Hours</b><span>Monday – Friday, 8:00 AM – 4:30 PM</span></div>
        </div>
        <div class="info-row">
          <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
          <div><b>Billing Questions</b><a href="tel:+19152464689">(915) 246-4689</a></div>
        </div>
      </div>

      <div class="info-card" style="margin-top:24px;">
        <h3 style="margin-bottom:.4em;">Prefer to pay online?</h3>
        <p style="margin-bottom:16px;font-size:.95rem;">Settle your balance quickly and securely through our billing portal.</p>
        <a class="btn btn--accent" href="/billing" style="width:100%;justify-content:center;">Pay My Bill</a>
      </div>
    </div>

    <!-- Form column -->
    <div class="reveal">
      <form class="form" data-demo novalidate>
        <div class="form-success">✓ Thanks! Your message has been sent — we'll be in touch within one business day.</div>
        <div class="form-row">
          <div class="field">
            <label for="fname">First Name</label>
            <input id="fname" name="fname" type="text" placeholder="Jane" required>
          </div>
          <div class="field">
            <label for="lname">Last Name</label>
            <input id="lname" name="lname" type="text" placeholder="Doe" required>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="you@email.com" required>
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" placeholder="(575) 000-0000">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="service">I'm interested in</label>
            <select id="service" name="service">
              <option value="">Select a service…</option>
              <option>Residential Trash Collection</option>
              <option>Commercial Dumpster Rental</option>
              <option>Disposal &amp; Junk Hauling</option>
              <option>Billing question</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="city">Your City</label>
            <select id="city" name="city">
              <option value="">Select…</option>
              <option>Chaparral, NM</option>
              <option>La Mesa, NM</option>
              <option>Anthony, NM</option>
              <option>Berino, NM</option>
              <option>Mesquite, NM</option>
              <option>Vado, NM</option>
              <option>Chamberino, NM</option>
              <option>La Union, NM</option>
              <option>San Miguel, NM</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" placeholder="Tell us a little about what you need…"></textarea>
        </div>
        <button type="submit" class="btn btn--accent btn--lg" style="width:100%;justify-content:center;">Send Message</button>
        <p class="form-note">Prefer to talk? Call us at <a href="tel:+15758240887">(575) 824-0887</a> during office hours.</p>
      </form>
    </div>

  </div>
</section>

<!-- Service area strip -->
<section class="section section--soft" style="padding-top:0;">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Serving the valley</span>
      <h2>Areas we cover</h2>
    </div>
    <div class="chips reveal">
      <span class="chip">Chaparral, NM</span>
      <span class="chip">La Mesa, NM</span>
      <span class="chip">Anthony, NM</span>
      <span class="chip">Berino, NM</span>
      <span class="chip">Mesquite, NM</span>
      <span class="chip">Vado, NM</span>
      <span class="chip">Chamberino, NM</span>
      <span class="chip">La Union, NM</span>
      <span class="chip">San Miguel, NM</span>
    </div>
  </div>
</section>
</Layout>
